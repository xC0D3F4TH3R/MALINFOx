# MALINFO — Production Environment Configuration
#
# Copy this file to .env and fill in ALL values before deployment.
# NEVER commit the actual .env file to version control.
# For government deployments, use a proper secrets manager (HashiCorp Vault, AWS Secrets Manager, etc.)

# =============================================================================
# GENERAL SETTINGS
# =============================================================================
APP_NAME=MALINFO
ENVIRONMENT=production
DEBUG=false
API_PREFIX=/api

# =============================================================================
# STORAGE SETTINGS
# =============================================================================
STORAGE_DIR=/opt/malinfo/storage
UPLOAD_DIR=/opt/malinfo/storage/uploads
REPORT_DIR=/opt/malinfo/storage/reports
PCAP_DIR=/opt/malinfo/storage/pcaps
MAX_UPLOAD_SIZE_MB=250

# =============================================================================
# DATABASE (PostgreSQL for production)
# =============================================================================
# Format: postgresql+asyncpg://user:password@host:port/database
DATABASE_URL=postgresql+asyncpg://malinfo:${POSTGRES_PASSWORD}@db:5432/malinfo

# =============================================================================
# REDIS (for caching, sessions, rate limiting)
# =============================================================================
REDIS_URL=redis://redis:6379/0

# =============================================================================
# YARA RULES
# =============================================================================
YARA_RULES_DIR=/opt/malinfo/app/rules/yara

# =============================================================================
# VM ORCHESTRATOR (Built-in QEMU/KVM Sandbox)
# =============================================================================
# Enable built-in VM orchestration (alternative to CAPEv2)
VM_ORCHESTRATOR_ENABLED=true
VM_STORAGE_DIR=/opt/malinfo/storage/vms
VM_ISO_DIR=/opt/malinfo/storage/isos
VM_AGENT_PORT=9090
LIBVIRT_URI=qemu:///system

# =============================================================================
# SANDBOX (CAPEv2 / Cuckoo-compatible REST API) - LEGACY
# =============================================================================
# Point this at your isolated detonation cluster.
# NEVER point this at production infrastructure with internet egress unless
# the sandbox network is deliberately firewalled / uses INetSim or FakeNet-NG.
SANDBOX_ENABLED=false
SANDBOX_API_URL=http://cape-controller.internal:8000
SANDBOX_API_TOKEN=
SANDBOX_POLL_INTERVAL_SEC=15
SANDBOX_TIMEOUT_SEC=600

# Sandbox profiles (VM templates in your CAPEv2 cluster)
SANDBOX_PROFILES={"windows": "win10-x64-clean", "linux": "ubuntu22-x64-clean", "android": "android13-x86-clean", "macos": "unavailable-requires-apple-silicon-host", "ios": "static-analysis-only"}

# =============================================================================
# THREAT INTELLIGENCE ENRICHMENT (Optional - requires API keys)
# =============================================================================
VIRUSTOTAL_API_KEY=
OTX_API_KEY=
ABUSEIPDB_API_KEY=
MISP_URL=
MISP_API_KEY=
MISP_VERIFY_SSL=true

# =============================================================================
# ICAP GATEWAY INTEGRATION (For authorized network gateways only)
# =============================================================================
# MALINFO does not sniff arbitrary third-party traffic. It exposes an
# ICAP-compatible endpoint so an authorized network gateway (e.g. Squid,
# a government CERT's secure web gateway, or an email gateway) can hand
# files to MALINFO for inspection *before* they are delivered to the end
# user, on infrastructure the deploying authority legally controls.
ICAP_ENABLED=false
ICAP_LISTEN_PORT=1344

# =============================================================================
# REAL-TIME FILE TRANSFER MONITORING
# =============================================================================
MONITOR_ENABLED=false
MONITOR_WATCH_PATHS=["/var/mail", "/home/*/Downloads", "/tmp"]
MONITOR_NETWORK_ENABLED=false
MONITOR_NETWORK_INTERFACE=any
MONITOR_NETWORK_FILTER="tcp or udp"
MONITOR_AUTO_ANALYZE=true

# =============================================================================
# WEBSOCKET / REAL-TIME UPDATES
# =============================================================================
WS_ENABLED=true
WS_PING_INTERVAL=30

# =============================================================================
# AUTHENTICATION & SECURITY
# =============================================================================
# CRITICAL: Generate a strong random secret (32+ chars)
# openssl rand -base64 32
SECRET_KEY=CHANGE_ME_BEFORE_DEPLOYMENT_USE_A_REAL_SECRET_KEY_32_CHARS_MIN

ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=30
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15

# =============================================================================
# CORS (Configure for your domain)
# =============================================================================
ALLOWED_ORIGINS=["https://malinfo.duckdns.org", "https://malinfo.yourdomain.xyz"]

# =============================================================================
# RATE LIMITING
# =============================================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# =============================================================================
# AUDIT LOGGING
# =============================================================================
AUDIT_LOG_RETENTION_DAYS=365
AUDIT_LOG_LEVEL=info

# =============================================================================
# DECOMPILER INTEGRATION
# =============================================================================
GHIDRA_PATH=/opt/ghidra
RETDEC_PATH=/usr/bin/retdec-decompiler
DECOMPILER_TIMEOUT_SEC=300

# =============================================================================
# EMAIL / AGENCY NOTIFICATION (SMTP)
# =============================================================================
# SMTP settings for sending agency notifications (CERT-In, Cyber Crime Cell, etc.)
# Use Gmail with App Password or your organization's SMTP server
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail@gmail.com
SMTP_PASSWORD=your-16-char-app-password
SMTP_TLS=true
NOTIFICATION_FROM_EMAIL=noreply@malinfo.duckdns.org
AGENCY_NOTIFICATION_EMAIL=ary4ntom4r@gmail.com

# =============================================================================
# POSTGRES PASSWORD (Set in deployment, not here)
# =============================================================================
# POSTGRES_PASSWORD= (injected by deployment system)

# =============================================================================
# GRAFANA PASSWORD (For monitoring stack)
# =============================================================================
# GRAFANA_PASSWORD= (injected by deployment system)